---
import Nav from "../components/Nav.astro"
import "../styles/global.css"
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}img/favicon.ico`} />
    <meta name="generator" content={Astro.generator} />
    <title> Brayan Cardenas | Desarrollador Frontend</title>
    <meta name="description" content="Portafolio de Brayan Cardenas, Frontend Developer. Creo experiencias digitales modernas con código limpio y UX excelente."/>
    <meta property="og:title" content="Brayan Cardenas | Desarrollador Frontend" />
    <meta property="og:description" content="Portafolio de Brayan Cardenas, Frontend Developer." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://brayancardenas.vercel.app" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:bg-negro focus:p-4 focus:text-azul"
    >
      Saltar al contenido
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  ::selection {
    background-color: var(--blanco);
    color: var(--negro);
  }
  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
