---
import SkillsImg from "../components/SkillsImg.astro";
---

<section
  id="skills"
  class="mx-auto flex min-h-screen w-[53em] flex-col items-center justify-center gap-[3em] max-[1190px]:max-w-[50em] max-[960px]:w-full"
>
  <div class="flex flex-col items-center justify-center gap-[2em] text-center">
    <h2 class="font-secundaria text-[1.2em] leading-normal">Tecnologías que manejo</h2>
    <div class="flex">
      <SkillsImg handling="manejo" />
    </div>
  </div>

  <div class="flex flex-col items-center justify-center gap-[2em] text-center">
    <h2 class="font-secundaria text-[1.2em] leading-normal">Estoy Aprendiendo</h2>
    <div class="flex">
      <SkillsImg handling="aprendiendo" />
    </div>
  </div>
</section>
