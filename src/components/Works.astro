---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import data from "../data/works";

import r3EnRaya from "../assets/img/works/3-en-raya.jpg";
import agenda from "../assets/img/works/agenda.jpg";
import apiPixabay from "../assets/img/works/api-pixabay.jpg";
import cafe from "../assets/img/works/cafe.jpg";
import carritoCompras from "../assets/img/works/carrito-compras.jpg";
import mundano from "../assets/img/works/mundano.jpg";
import weiddgan from "../assets/img/works/weiddgan.jpg";
import xbox from "../assets/img/works/xbox.jpg";

const IMAGES: Record<string, ImageMetadata> = {
  "3-en-raya.jpg": r3EnRaya,
  "agenda.jpg": agenda,
  "api-pixabay.jpg": apiPixabay,
  "cafe.jpg": cafe,
  "carrito-compras.jpg": carritoCompras,
  "mundano.jpg": mundano,
  "weiddgan.jpg": weiddgan,
  "xbox.jpg": xbox,
};
---

<section
  id="works"
  class="mx-auto flex min-h-screen max-w-[53em] flex-col items-center justify-center gap-[2em] text-center mb-[1em] max-[1190px]:max-w-[50em] max-[630px]:min-h-0"
>
  <div class="max-[960px]:my-[2em] max-[960px]:w-[90%]">
    <h2 class="font-secundaria text-[1.2em] leading-normal">Todos</h2>
  </div>

  <div class="flex w-full flex-wrap items-start justify-center gap-[0.5em]">
    {
      data.works.map(({ name, img, url, github }) => (
        <div>
          <div class="group relative overflow-hidden">
            <Image
              class="h-[9.79em] w-[17.235em] object-cover transition-transform duration-300 group-hover:scale-[1.2] group-focus-within:scale-[1.2] max-[630px]:h-auto max-[630px]:w-full max-[630px]:px-[1em] max-[960px]:group-hover:scale-100 max-[960px]:group-focus-within:scale-100"
              src={IMAGES[img]}
              alt={name}
              loading="lazy"
            />
            <div
              class="absolute inset-x-0 bottom-0 z-[1] flex w-full items-center justify-center gap-[2em] bg-black/85 py-[1em] opacity-0 pointer-events-none transition-opacity duration-300 group-hover:opacity-100 group-hover:pointer-events-auto group-hover:animate-rise group-focus-within:opacity-100 group-focus-within:pointer-events-auto max-[960px]:static max-[960px]:my-[1em] max-[960px]:gap-[4em] max-[960px]:bg-transparent max-[960px]:p-0 max-[960px]:opacity-100 max-[960px]:pointer-events-auto"
            >
              <a
                class="cursor-pointer border border-blanco px-[2.5em] py-[0.7em] text-[0.7em] transition-all duration-300 hover:bg-blanco hover:text-negro max-[960px]:text-[1em]"
                href={url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Web
              </a>
              <a
                class="cursor-pointer border border-blanco px-[2.5em] py-[0.7em] text-[0.7em] transition-all duration-300 hover:bg-blanco hover:text-negro max-[960px]:text-[1em]"
                href={github}
                target="_blank"
                rel="noopener noreferrer"
              >
                Info
              </a>
            </div>
          </div>
          <h2 class="p-[0.5em] font-secundaria text-[0.9em]">{name}</h2>
        </div>
      ))
    }
  </div>
</section>
