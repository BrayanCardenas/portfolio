---
import logo from "../assets/img/header/LOGO.svg";
const LINKS = [
  { href: "#home", label: "Acerca de" },
  { href: "#skills", label: "Habilidades" },
  { href: "#works", label: "Proyectos" },
];
---

<div
  id="nav"
  class="max-[960px]:fixed max-[960px]:inset-0 max-[960px]:z-[3] max-[960px]:flex max-[960px]:w-full max-[960px]:flex-col max-[960px]:items-center max-[960px]:justify-center max-[960px]:gap-[2.5em] max-[960px]:bg-negro max-[960px]:text-center max-[960px]:transition-all max-[960px]:duration-[330ms] max-[960px]:ease-out max-[960px]:invisible max-[960px]:opacity-0 max-[960px]:scale-[0.95] max-[960px]:pointer-events-none max-[960px]:data-open:visible max-[960px]:data-open:opacity-100 max-[960px]:data-open:scale-100 max-[960px]:data-open:pointer-events-auto"
>
<div class="fixed inset-y-0 left-0 my-[3.5em] mx-[2em] flex flex-col items-center justify-between max-[960px]:static max-[960px]:my-0 max-[960px]:mx-0 max-[960px]:gap-[2.5em]">
    <a href={`${import.meta.env.BASE_URL}`} aria-label="Ir al inicio">
      <img class="w-[5.6em]" src={logo.src} alt="" />
    </a>
    <nav aria-label="Navegación principal">
      <ul class="max-[960px]:flex max-[960px]:flex-col max-[960px]:gap-[2em]">        {LINKS.map((link) => (
          <li class="my-[2em] max-[960px]:my-0">
            <a data-spy class="transition-colors duration-300 hover:text-azul" href={link.href}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      class="cursor-pointer border border-azul px-[2em] py-[0.7em] text-azul transition-colors duration-300 hover:bg-azul hover:text-negro"
      href={`${import.meta.env.BASE_URL}document/CV.pdf`}
      target="_blank"
      rel="noopener noreferrer"
    >
      CV
    </a>
  </div>

  <div class="fixed inset-y-0 right-0 my-[3.5em] mx-[2em] flex flex-col items-center justify-between max-[960px]:static max-[960px]:my-0 max-[960px]:mx-0 max-[960px]:gap-[2.5em]">
    <ul class="flex flex-col items-center gap-[1.5em] max-[960px]:flex-row max-[960px]:gap-[2em]">
      <li>
        <a href="https://github.com/BrayanCardenas" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
          <svg class="size-[1.4em] fill-white transition-colors duration-300 hover:fill-azul max-[960px]:size-[2em]" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M5.883 18.653c-.3-.2-.558-.455-.86-.816a50.32 50.32 0 0 1-.466-.579c-.463-.575-.755-.84-1.057-.949a1 1 0 0 1 .676-1.883c.752.27 1.261.735 1.947 1.588-.094-.117.34.427.433.539.19.227.33.365.44.438.204.137.587.196 1.15.14.023-.382.094-.753.202-1.095C5.38 15.31 3.7 13.396 3.7 9.64c0-1.24.37-2.356 1.058-3.292-.218-.894-.185-1.975.302-3.192a1 1 0 0 1 .63-.582c.081-.024.127-.035.208-.047.803-.123 1.937.17 3.415 1.096A11.731 11.731 0 0 1 12 3.315c.912 0 1.818.104 2.684.308 1.477-.933 2.613-1.226 3.422-1.096.085.013.157.03.218.05a1 1 0 0 1 .616.58c.487 1.216.52 2.297.302 3.19.691.936 1.058 2.045 1.058 3.293 0 3.757-1.674 5.665-4.642 6.392.125.415.19.879.19 1.38a300.492 300.492 0 0 1-.012 2.716 1 1 0 0 1-.019 1.958c-1.139.228-1.983-.532-1.983-1.525l.002-.446.005-.705c.005-.708.007-1.338.007-1.998 0-.697-.183-1.152-.425-1.36-.661-.57-.326-1.655.54-1.752 2.967-.333 4.337-1.482 4.337-4.66 0-.955-.312-1.744-.913-2.404a1 1 0 0 1-.19-1.045c.166-.414.237-.957.096-1.614l-.01.003c-.491.139-1.11.44-1.858.949a1 1 0 0 1-.833.135A9.626 9.626 0 0 0 12 5.315c-.89 0-1.772.119-2.592.35a1 1 0 0 1-.83-.134c-.752-.507-1.374-.807-1.868-.947-.144.653-.073 1.194.092 1.607a1 1 0 0 1-.189 1.045C6.016 7.89 5.7 8.694 5.7 9.64c0 3.172 1.371 4.328 4.322 4.66.865.097 1.201 1.177.544 1.748-.192.168-.429.732-.429 1.364v3.15c0 .986-.835 1.725-1.96 1.528a1 1 0 0 1-.04-1.962v-.99c-.91.061-1.662-.088-2.254-.485z" fill-rule="nonzero" />
          </svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/brayancardenas34" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg class="size-[1.4em] fill-white transition-colors duration-300 hover:fill-azul max-[960px]:size-[2em]" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M6.94 5a2 2 0 1 1-4-.002 2 2 0 0 1 4 .002zM7 8.48H3V21h4V8.48zm6.32 0H9.34V21h3.94v-6.57c0-3.66 4.77-4 4.77 0V21H22v-7.93c0-6.17-7.06-5.94-8.72-2.91l.04-1.68z" fill-rule="nonzero" />
          </svg>
        </a>
      </li>
    </ul>
    <a
      class="text-azul [writing-mode:vertical-lr] max-[960px]:text-[1em] max-[960px]:[writing-mode:horizontal-tb]"
      href="mailto:brayansti34&#64;gmail.com"
    >
      brayansti34&#64;gmail.com
    </a>
  </div>
</div>

<script>
  const nav = document.getElementById("nav")!;
  const button = document.getElementById("menu-button")!;

  const setOpen = (open: boolean) => {
    button.setAttribute("aria-expanded", String(open));
    button.toggleAttribute("data-open", open);
    nav.toggleAttribute("data-open", open);
  };

  button.addEventListener("click", () => {
    setOpen(button.getAttribute("aria-expanded") !== "true");
  });

  document.querySelectorAll("#nav a[href^='#']").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        document.querySelectorAll("[data-spy]").forEach((a) => {
          a.classList.toggle("text-azul", a.getAttribute("href") === `#${entry.target.id}`);
        });
      });
    },
    { rootMargin: "-50% 0px -50% 0px" },
  );

  document.querySelectorAll("section[id]").forEach((s) => spy.observe(s));
</script>

<button
  type="button"
  id="menu-button"
  class="fixed right-[2em] bottom-[2em] z-[3] hidden size-16 flex-col items-center justify-between rounded-full bg-negro p-4 shadow-[12px_12px_17px_4px_#1b1b1b,-12px_-12px_17px_4px_#353535] max-[960px]:flex"
  aria-expanded="false"
  aria-controls="nav"
  aria-label="Abrir menú"
>
  <span class="hamburger-line--half hamburger-line--start h-1 w-1/2 origin-right self-start rounded-[5px] bg-white"></span>
  <span class="h-1 w-full rounded-[5px] bg-white"></span>
  <span class="hamburger-line--half hamburger-line--end h-1 w-1/2 origin-left self-end rounded-[5px] bg-white"></span>
</button>

<style>
  #menu-button {
    transition: transform 330ms ease-out;
  }
  #menu-button[data-open] {
    transform: rotate(-45deg);
  }
  .hamburger-line--half {
    transition: transform 330ms cubic-bezier(0.54, -0.81, 0.57, 0.57);
  }
  #menu-button[data-open] .hamburger-line--start {
    transform: rotate(-90deg) translateX(2px);
  }
  #menu-button[data-open] .hamburger-line--end {
    transform: rotate(-90deg) translateX(-3px);
  }
</style>
