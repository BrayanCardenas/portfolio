---
import data from "../data/skills.json";
const { handling } = Astro.props;

const filteredSkills = data.skills.filter((skill) =>
  handling === "aprendiendo" ? skill.aprendiendo : !skill.aprendiendo,
);
---

<ul class="flex flex-row items-center justify-center gap-[1.8em]">
  {
    filteredSkills.map(({ img, name, aprendiendo, categoria }) => (
      <li
        data-learning={aprendiendo}
        data-category={categoria}
        class="flex w-[3.5em] flex-col items-center justify-center text-azul"
      >
        <img
          class="img"
          src={`${import.meta.env.BASE_URL}img/skills/${img}`}
          loading="lazy"
          alt={name}
        />
        <span class="skill-name">{name}</span>
      </li>
    ))
  }
</ul>
